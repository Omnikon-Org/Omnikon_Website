# Server-Only Environment Template (Zero exposed NEXT_PUBLIC_ keys)

# Supabase Credentials (Server-only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_PASSWORD="your-supabase-db-password"
SITE_URL="http://localhost:3000"

# Firebase Credentials (Server-only)
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_AUTH_DOMAIN="your-firebase-app.firebaseapp.com"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_STORAGE_BUCKET="your-firebase-app.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="your-app-id"
FIREBASE_MEASUREMENT_ID="your-measurement-id"

# API Tokens (Server-only)
GITHUB_TOKEN="your-github-personal-access-token"
DEVTO_API_KEY="your-devto-api-key"
HASHNODE_ACCESS_TOKEN="your-hashnode-access-token"
